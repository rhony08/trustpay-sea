# Copy to .env (gitignored). Every variable the stack reads.

# --- API ---
DATABASE_URL=postgresql+asyncpg://trustpay:trustpay@localhost:5432/trustpay
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=dev

# --- Datastore credentials (compose reads these; never commit real values) ---
# docker-compose.yml / deploy/gcp compose require POSTGRES_PASSWORD from the
# environment — there is no default. Put real values in a gitignored .env.
POSTGRES_USER=trustpay
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=trustpay

# JWT (RS256). In dev the API generates a keypair at these paths if missing.
# In prod mount real keys via secret manager — self-generation is refused.
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Rate limiting (token bucket)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_MINUTE=60

# Scheduler placeholder jobs (Phase 0.5)
SCHEDULER_ENABLED=true

# Optional integrations — mock-first, graceful degradation (ADR-012)
GEMINI_API_KEY=
FACTCHECK_API_KEY=

# Malaysia gov checker — PDRM Semak Mule (env-only; checker disabled when unset)
SEMAKMULE_API_KEY=
SEMAKMULE_BASE_URL=https://semakmule.rmp.gov.my/api/mule/get_search_data.php
SEMAKMULE_TIMEOUT_SECONDS=8
SEMAKMULE_VERIFY_TLS=true

# AI provider: mock (default) | gcp (Vertex AI via ADC) | openrouter
AI_PROVIDER=mock
# GCP / Vertex AI (preferred in the GCP deploy; uses Application Default Credentials)
GCP_PROJECT=
GCP_LOCATION=global
GCP_VISION_MODEL=gemini-3.1-flash-lite
GCP_TEXT_MODEL=gemini-3.1-flash-lite
# OpenRouter (alternative)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.1-flash-lite-001

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Deploy (VPS / GCE) ---
# Comma-separated CORS origins; set to the public site URL behind nginx.
CORS_ALLOW_ORIGINS=https://trustpay.quesitive.com
# Public API URL baked into the web build (rebuild web image if it changes).
# NEXT_PUBLIC_API_URL=https://trustpay.quesitive.com
#
# This deployment reuses the host's existing datastores (no DB/Redis containers):
#   DATABASE_URL=postgresql+asyncpg://trustpay:trustpay@host.docker.internal:5432/trustpay
#   REDIS_URL=redis://rr-redis:6379/2

# Data retention (Phase 10 / docs/10). Dry-run by default — set false to enforce.
RETENTION_DRY_RUN=true
RETENTION_EVIDENCE_DAYS=90

# Evidence image compression (storage saving). Uploads are re-encoded as JPEG at
# this quality and the longest edge is downscaled to this many pixels (0 = off).
EVIDENCE_MAX_DIMENSION=1920
EVIDENCE_JPEG_QUALITY=80

# Notifications (G-15). In-app is always on; email is opt-in (console sender when off).
NOTIFICATIONS_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
NOTIFICATIONS_FROM_EMAIL=TrustPay SEA <no-reply@trustpay.quesitive.com>

# Auth hardening (ADR-020). Prod MUST set MFA_REQUIRED_FOR_ADMINS=true
# (admins then cannot log in without an enrolled passkey) and COOKIE_SECURE=true.
MFA_REQUIRED_FOR_ADMINS=false
MFA_STEP_UP_SECONDS=300
COOKIE_SECURE=false
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=TrustPay SEA
WEBAUTHN_ORIGIN=http://localhost:3000

# --- Crypto secrets (ADR-002/013). Dev defaults are INSECURE placeholders; the
# API refuses to boot with ENVIRONMENT=prod unless these are set. Generate with:
#   openssl rand -hex 32
ACCOUNT_HMAC_KEY=dev-only-insecure-key-change-me
RECEIPT_SIGNING_KEY=dev-only-insecure-receipt-key
