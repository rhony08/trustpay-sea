# TrustPay SEA — Caddy reverse proxy for the single-VM GCP deploy.
#
# Uses the provided origin certificate (Cloudflare Origin CA) so Cloudflare can
# run in Full (strict) mode. Put the cert + key at deploy/gcp/certs/tls.pem and
# deploy/gcp/certs/tls.key (mounted read-only into the container).
#
# Routing:
#   /api/*, /media/*, /healthz, /docs*, /openapi.json  -> FastAPI  (api:8000)
#   everything else                                     -> Next.js  (web:3000)

{$DOMAIN} {
	encode gzip
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Provided origin cert (no ACME). Remove this line to fall back to auto-TLS.
	tls /etc/caddy/certs/tls.pem /etc/caddy/certs/tls.key

	@api path /api/* /media/* /healthz /docs /docs/* /openapi.json
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}
