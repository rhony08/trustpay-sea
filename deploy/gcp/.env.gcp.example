# TrustPay SEA — GCE single-VM environment template.
# Copy to deploy/gcp/.env.gcp and fill in. This file is gitignored.

# --- public identity ---
# DOMAIN drives Caddy TLS + WebAuthn RP id. Use a hostname (auto-HTTPS) or ":80".
DOMAIN=trustpay.example.com
# PUBLIC_URL must match DOMAIN and is baked into the web bundle + CORS.
PUBLIC_URL=https://trustpay.example.com

# --- datastores (containers on this VM) ---
POSTGRES_USER=trustpay
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=trustpay

# --- runtime ---
# prod refuses self-generated JWT keys (generate them once — see docs/13 §4).
ENVIRONMENT=prod
MFA_REQUIRED_FOR_ADMINS=true

# --- AI (pick one) ---
# gcp  -> Vertex AI via the VM service account (ADC); needs roles/aiplatform.user
# openrouter -> set OPENROUTER_API_KEY
# mock -> local heuristics only (no key, always works)
AI_PROVIDER=mock
GCP_PROJECT=
GCP_LOCATION=asia-southeast1
GCP_VISION_MODEL=gemini-2.0-flash
GCP_TEXT_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=

# --- optional integrations ---
SEMAKMULE_API_KEY=
